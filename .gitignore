# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# .env.test holds no real secrets (dummy NEXTAUTH_SECRET, same local-only
# Postgres password as .env) — committed so `npm test` works for anyone who
# clones the repo without them having to hand-assemble it first.
!.env.test

# vercel
.vercel

# User-uploaded product images (src/lib/image-upload.ts) — runtime data,
# not source. Persisted via the uploads_data Docker volume in production
# (docker-compose.yml), never committed here.
/public/uploads/

# typescript
*.tsbuildinfo
next-env.d.ts
.playwright-mcp/
