generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Real DB-level constraints for a few string fields that used to rely
// entirely on application-level allow-lists (validation gaps in exactly
// these three were real bugs fixed this session: PUT /api/sales/[id]'s
// status/payment_status, and POST/PUT /api/promotions' discount_type).
// The app-level checks stay in place too — they produce a clean 400
// instead of a raw Prisma validation error — this is defense in depth,
// not a replacement.
enum SaleStatus {
  completed
  cancelled
}

enum PaymentStatus {
  paid
  unpaid
}

enum DiscountType {
  percentage
  fixed
}

// A tenant. Everything else in this schema (branches/Warehouse, catalog,
// users, roles) belongs to exactly one Shop — see [[l-corner-manage-status]]
// for the multi-tenant restructuring this was introduced for.
model Shop {
  id         String   @id @default(uuid())
  name_i18n  Json
  logo_path  String?
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  warehouses    Warehouse[]
  users         User[]
  categories    Category[]
  products      Product[]
  product_types ProductType[]
  units         Unit[]
  promotions    Promotion[]
  toppings      Topping[]
  roles         Role[]
  app_settings  AppSettings?

  @@map("shops")
}

model User {
  id             String   @id @default(uuid())
  // Nullable: a super admin (is_super_admin = true) belongs to no shop and
  // provisions new shops; every other user must have a shop_id.
  shop_id        String?
  username       String   @unique
  email          String   @unique
  password       String
  full_name      String
  is_active      Boolean  @default(true)
  is_super_admin Boolean  @default(false)
  created_at     DateTime @default(now())
  updated_at     DateTime @updatedAt

  shop              Shop?           @relation(fields: [shop_id], references: [id])
  user_roles        UserRole[]
  user_warehouses   UserWarehouse[]
  created_sales     Sale[]          @relation("SaleCreatedBy")
  created_transfers StockTransfer[]
  created_refunds   SaleRefund[]    @relation("RefundCreatedBy")

  @@index([shop_id])
  @@map("users")
}

model Role {
  id                String   @id @default(uuid())
  shop_id           String
  name              String
  display_name_i18n Json
  description_i18n  Json?
  permissions       Json     @default("[]")
  is_system         Boolean  @default(false)
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  shop       Shop       @relation(fields: [shop_id], references: [id])
  user_roles UserRole[]

  @@unique([shop_id, name])
  @@map("roles")
}

model UserRole {
  id         String   @id @default(uuid())
  user_id    String
  role_id    String
  created_at DateTime @default(now())

  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role Role @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@unique([user_id, role_id])
  @@index([role_id])
  @@map("user_roles")
}

model UserWarehouse {
  id           String   @id @default(uuid())
  user_id      String
  warehouse_id String
  created_at   DateTime @default(now())

  user      User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouse_id], references: [id], onDelete: Cascade)

  @@unique([user_id, warehouse_id])
  @@index([warehouse_id])
  @@map("user_warehouses")
}

// Language model removed - not used in the system

model Unit {
  id                String   @id @default(uuid())
  shop_id           String
  name_i18n         Json
  abbreviation_i18n Json
  unit_type         String?
  is_base_unit      Boolean  @default(false)
  is_active         Boolean  @default(true)
  created_at        DateTime @default(now())

  shop               Shop               @relation(fields: [shop_id], references: [id])
  products_as_base   Product[]          @relation("BaseUnit")
  recipe_ingredients RecipeIngredient[]
  recipes            Recipe[]           @relation("ServingUnit")

  @@index([shop_id])
  @@map("units")
}

// UnitConversion model removed - not used in the system

model Category {
  id         String   @id @default(uuid())
  shop_id    String
  name_i18n  Json
  parent_id  String?
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  shop     Shop       @relation(fields: [shop_id], references: [id])
  parent   Category?  @relation("CategoryTree", fields: [parent_id], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([shop_id])
  @@map("categories")
}

// A DB-level partial unique index also exists on this table, outside
// Prisma's schema (partial/filtered indexes aren't expressible in the
// Prisma schema DSL — no WHERE clause on @@unique/@@index): `CREATE UNIQUE
// INDEX warehouses_is_default_true_idx ON warehouses (shop_id) WHERE
// (is_default = true)` — at most one default warehouse per shop. Hand-added
// as raw SQL to the `20260804154812_init_multi_tenant` migration, per
// Prisma's documented "customizing migrations" pattern for unsupported
// features — future `prisma migrate dev` runs treat it as part of history
// and won't try to drop it. Originally global (one default warehouse in the
// whole system) from the single-shop era; rescoped to per-shop when the
// Shop model was introduced, since every shop needs its own default.
model Warehouse {
  id           String   @id @default(uuid())
  shop_id      String
  code         String
  name_i18n    Json
  address      String?  @db.Text
  latitude     Float?
  longitude    Float?
  promptpay_id String?
  is_active    Boolean  @default(true)
  is_default   Boolean  @default(false)
  created_at   DateTime @default(now())

  shop            Shop            @relation(fields: [shop_id], references: [id])
  sales           Sale[]
  stock           ProductStock[]
  transfers_out   StockTransfer[] @relation("TransferFrom")
  transfers_in    StockTransfer[] @relation("TransferTo")
  user_warehouses UserWarehouse[]
  payment_intents PaymentIntent[]

  @@unique([shop_id, code])
  @@map("warehouses")
}

// Per-warehouse stock level for a product. Replaces the old single global
// Product.current_stock — every product's actual quantity now depends on
// which warehouse you're asking about. A product with no row here at a given
// warehouse simply hasn't been stocked/produced/transferred there yet (treat
// as 0, not an error).
model ProductStock {
  id                  String   @id @default(uuid())
  product_id          String
  warehouse_id        String
  current_stock       Decimal  @default(0) @db.Decimal(15, 4)
  min_stock_level     Decimal  @default(0) @db.Decimal(15, 4)
  low_stock_threshold Decimal  @default(0) @db.Decimal(15, 4)
  is_active           Boolean  @default(true)
  updated_at          DateTime @updatedAt

  // Cascades on product delete — a per-branch visibility/quantity row has no
  // meaning independent of the product it belongs to (same blast radius as
  // ProductMedia/ProductTopping below, which already cascade this way).
  product   Product   @relation(fields: [product_id], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouse_id], references: [id])

  @@unique([product_id, warehouse_id])
  @@index([warehouse_id])
  @@map("product_stocks")
}

// A stock move from one warehouse to another. Modeled as an instant, atomic
// operation (no in-transit status) — appropriate for a small business moving
// stock between a handful of nearby branches, not enterprise logistics. Each
// transfer also writes a paired "out"/"in" StockMovement at its two
// warehouses for the audit trail (reference_type "transfer", reference_id =
// this row's id).
model StockTransfer {
  id                String   @id @default(uuid())
  from_warehouse_id String
  to_warehouse_id   String
  product_id        String
  quantity          Decimal  @db.Decimal(15, 4)
  note              String?  @db.Text
  created_by        String?
  created_at        DateTime @default(now())

  from_warehouse  Warehouse @relation("TransferFrom", fields: [from_warehouse_id], references: [id])
  to_warehouse    Warehouse @relation("TransferTo", fields: [to_warehouse_id], references: [id])
  product         Product   @relation(fields: [product_id], references: [id])
  created_by_user User?     @relation(fields: [created_by], references: [id])

  @@index([from_warehouse_id])
  @@index([to_warehouse_id])
  @@index([product_id])
  @@map("stock_transfers")
}

model Product {
  id               String  @id @default(uuid())
  shop_id          String
  code             String  @unique
  name_i18n        Json
  description_i18n Json?
  category_id      String?
  product_type_id  String
  base_unit_id     String
  is_active        Boolean @default(true)
  has_serial       Boolean @default(false)
  has_expiry       Boolean @default(false)

  // Stock management — actual quantities live in ProductStock (per
  // warehouse); track_stock is a product-level policy flag, not a quantity,
  // so it stays here.
  track_stock Boolean @default(true)

  // Pricing (merged from ProductUnit for base unit)
  selling_price Decimal? @db.Decimal(15, 2)
  cost_price    Decimal? @db.Decimal(15, 2)

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  shop                   Shop               @relation(fields: [shop_id], references: [id])
  category               Category?          @relation(fields: [category_id], references: [id])
  product_type           ProductType        @relation(fields: [product_type_id], references: [id])
  base_unit              Unit               @relation("BaseUnit", fields: [base_unit_id], references: [id])
  recipes                Recipe[]
  recipe_ingredients     RecipeIngredient[] @relation("IngredientProduct")
  sale_items             SaleItem[]
  media                  ProductMedia[]
  toppings_as_ingredient Topping[]          @relation("ToppingIngredientProduct")
  available_toppings     ProductTopping[]
  stock                  ProductStock[]
  transfers              StockTransfer[]

  @@index([shop_id])
  @@index([product_type_id])
  @@index([category_id])
  @@index([is_active])
  @@map("products")
}

// ProductUnit model removed - using Product.selling_price and base_unit instead

model Recipe {
  id              String   @id @default(uuid())
  product_id      String
  name_i18n       Json
  is_default      Boolean  @default(false)
  serving_qty     Decimal  @default(1) @db.Decimal(15, 4)
  serving_unit_id String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())

  product      Product            @relation(fields: [product_id], references: [id])
  serving_unit Unit?              @relation("ServingUnit", fields: [serving_unit_id], references: [id])
  ingredients  RecipeIngredient[]
  sale_items   SaleItem[]

  @@index([product_id])
  @@map("recipes")
}

model RecipeIngredient {
  id            String   @id @default(uuid())
  recipe_id     String
  ingredient_id String
  quantity      Decimal  @db.Decimal(15, 4)
  unit_id       String
  base_quantity Decimal? @db.Decimal(15, 4)
  is_optional   Boolean  @default(false)
  note_i18n     Json?
  created_at    DateTime @default(now())

  recipe     Recipe  @relation(fields: [recipe_id], references: [id])
  ingredient Product @relation("IngredientProduct", fields: [ingredient_id], references: [id])
  unit       Unit    @relation(fields: [unit_id], references: [id])

  @@index([recipe_id])
  @@index([ingredient_id])
  @@index([unit_id])
  @@map("recipe_ingredients")
}

// Topping / add-on: only ever attached to SEMI_FINISHED products (drinks). Its
// stock is deducted from a real ingredient Product at sale time, same as a
// recipe ingredient, but the ingredient/quantity is fixed per topping rather
// than per recipe.
model Topping {
  id                   String   @id @default(uuid())
  shop_id              String
  name_i18n            Json
  price                Decimal  @db.Decimal(15, 2)
  ingredient_id        String
  quantity_per_serving Decimal  @db.Decimal(15, 4)
  is_active            Boolean  @default(true)
  created_at           DateTime @default(now())
  updated_at           DateTime @updatedAt

  shop               Shop              @relation(fields: [shop_id], references: [id])
  ingredient         Product           @relation("ToppingIngredientProduct", fields: [ingredient_id], references: [id])
  available_on       ProductTopping[]
  sale_item_toppings SaleItemTopping[]

  @@index([shop_id])
  @@index([ingredient_id])
  @@map("toppings")
}

// Which SEMI_FINISHED products may offer which toppings at the POS.
model ProductTopping {
  id         String   @id @default(uuid())
  product_id String
  topping_id String
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  topping Topping @relation(fields: [topping_id], references: [id], onDelete: Cascade)

  @@unique([product_id, topping_id])
  @@index([topping_id])
  @@map("product_toppings")
}

// Stock, StockTransaction, StockAlert models removed - using Product.current_stock instead
// Customer model removed - using walk-in sales only

model Sale {
  id              String        @id @default(uuid())
  sale_number     String        @unique
  sale_date       DateTime      @default(now())
  warehouse_id    String
  subtotal        Decimal       @db.Decimal(15, 2)
  discount_amount Decimal       @default(0) @db.Decimal(15, 2)
  tax_rate        Decimal       @default(0) @db.Decimal(5, 2)
  tax_amount      Decimal       @default(0) @db.Decimal(15, 2)
  total_amount    Decimal       @db.Decimal(15, 2)
  payment_method  String?
  payment_status  PaymentStatus @default(paid)
  status          SaleStatus    @default(completed)
  created_by      String?
  note            String?       @db.Text
  created_at      DateTime      @default(now())

  // Promotion applied at checkout. `promotion_code` is a snapshot of the code
  // actually used, kept even if the Promotion is later edited/deactivated.
  promotion_id   String?
  promotion_code String?

  // Client-generated, one per checkout attempt (not per HTTP request) — a
  // double-submit (double-click past the UI's own guard, a network retry,
  // two tabs) reuses the same key, so POST /api/sales can detect it's a
  // replay and return the original sale instead of creating a duplicate.
  // Null for any request that doesn't send one (fully optional).
  idempotency_key String? @unique

  warehouse       Warehouse      @relation(fields: [warehouse_id], references: [id])
  created_by_user User?          @relation("SaleCreatedBy", fields: [created_by], references: [id])
  promotion       Promotion?     @relation(fields: [promotion_id], references: [id])
  items           SaleItem[]
  refunds         SaleRefund[]
  payment_intent  PaymentIntent?

  @@index([warehouse_id])
  @@index([created_by])
  @@index([promotion_id])
  @@map("sales")
}

enum PaymentIntentStatus {
  pending
  succeeded
  failed
  expired
}

// Represents a gateway payment (Omise/2C2P/PayPal/...) between "checkout
// started" and "Sale actually created" — the two are no longer the same
// instant once payment can be asynchronous (a card charge can be
// synchronous, but PromptPay/wallet-style methods only confirm seconds to
// minutes later via a webhook). `status`/`sale_id` here are a best-effort
// cache for the polling UI, NOT the source of truth for "was this paid" —
// that's still `Sale` existing at all (via `Sale.idempotency_key =
// PaymentIntent.id`), exactly as it is for cash/manual-QR today. See
// src/lib/payments/reconcile.ts.
model PaymentIntent {
  id                       String              @id @default(uuid())
  driver                   String // "omise" | "2c2p" | "paypal" | "truemoney" | "rabbit_line_pay"
  method                   String // "card" | "promptpay" | ...
  warehouse_id             String
  amount                   Decimal             @db.Decimal(15, 2)
  status                   PaymentIntentStatus @default(pending)
  gateway_reference        String?             @unique
  qr_image_url             String?
  // Raw string to render as a client-generated QR (via react-qr-code) rather
  // than an <img> pointed at a gateway-hosted image — used by drivers like
  // PayPal that hand back a redirect URL for the customer to open, not a
  // pre-rendered QR image the way Omise's scannable_code does. Never both
  // set for the same intent.
  qr_payload               String?
  // Raw checkout body (items/discount/promotion_code/note/payment_method) —
  // re-resolved against LIVE prices/stock/promotion state every time a Sale
  // is actually created from it, never trusted as a stale snapshot.
  cart_snapshot            Json
  sale_id                  String?             @unique
  failure_reason           String?             @db.Text
  raw_last_webhook_payload Json?
  created_by               String?
  created_at               DateTime            @default(now())
  updated_at               DateTime            @updatedAt
  expires_at               DateTime?

  warehouse Warehouse @relation(fields: [warehouse_id], references: [id])
  sale      Sale?     @relation(fields: [sale_id], references: [id])

  @@index([warehouse_id])
  @@index([created_by])
  @@map("payment_intents")
}

model SaleItem {
  id               String   @id @default(uuid())
  sale_id          String
  product_id       String
  recipe_id        String?
  quantity         Decimal  @db.Decimal(15, 4)
  unit_price       Decimal  @db.Decimal(15, 2)
  discount_percent Decimal  @default(0) @db.Decimal(5, 2)
  discount_amount  Decimal  @default(0) @db.Decimal(15, 2)
  total_amount     Decimal  @db.Decimal(15, 2)
  cost_price       Decimal? @db.Decimal(15, 2)
  base_quantity    Decimal? @db.Decimal(15, 4)
  note             String?  @db.Text
  created_at       DateTime @default(now())

  sale         Sale              @relation(fields: [sale_id], references: [id])
  product      Product           @relation(fields: [product_id], references: [id])
  recipe       Recipe?           @relation(fields: [recipe_id], references: [id])
  toppings     SaleItemTopping[]
  refund_items SaleRefundItem[]

  @@index([sale_id])
  @@index([product_id])
  @@index([recipe_id])
  @@map("sale_items")
}

// A single refund transaction against a sale — one cashier action can
// return several line items (or partial quantities of them) at once.
// Refunded quantity is deliberately NOT a running total stored on SaleItem;
// it's computed by summing SaleRefundItem rows for that item, so the
// original sold quantity in sale_items never gets mutated and every refund
// stays in the audit trail (same reasoning as StockMovement elsewhere in
// this schema).
model SaleRefund {
  id            String   @id @default(uuid())
  sale_id       String
  refund_number String   @unique
  total_amount  Decimal  @db.Decimal(15, 2)
  reason        String?  @db.Text
  created_by    String?
  created_at    DateTime @default(now())

  sale            Sale             @relation(fields: [sale_id], references: [id])
  created_by_user User?            @relation("RefundCreatedBy", fields: [created_by], references: [id])
  items           SaleRefundItem[]

  @@index([sale_id])
  @@map("sale_refunds")
}

model SaleRefundItem {
  id             String  @id @default(uuid())
  sale_refund_id String
  sale_item_id   String
  quantity       Decimal @db.Decimal(15, 4)
  amount         Decimal @db.Decimal(15, 2)

  sale_refund SaleRefund @relation(fields: [sale_refund_id], references: [id], onDelete: Cascade)
  sale_item   SaleItem   @relation(fields: [sale_item_id], references: [id])

  @@index([sale_refund_id])
  @@index([sale_item_id])
  @@map("sale_refund_items")
}

// Toppings actually selected for a given sale item. `unit_price` snapshots the
// Topping's price at the time of sale so later price edits don't rewrite history.
model SaleItemTopping {
  id           String   @id @default(uuid())
  sale_item_id String
  topping_id   String
  quantity     Decimal  @default(1) @db.Decimal(15, 4)
  unit_price   Decimal  @db.Decimal(15, 2)
  created_at   DateTime @default(now())

  sale_item SaleItem @relation(fields: [sale_item_id], references: [id], onDelete: Cascade)
  topping   Topping  @relation(fields: [topping_id], references: [id])

  @@index([sale_item_id])
  @@index([topping_id])
  @@map("sale_item_toppings")
}

// Supplier, PurchaseOrder, PurchaseOrderItem models removed - not using purchase order system

// Promotion code applied at POS checkout. Supports percentage or fixed-amount
// discounts, an optional usage cap, and an optional expiry date.
model Promotion {
  id             String       @id @default(uuid())
  shop_id        String
  code           String       @unique
  name_i18n      Json
  discount_type  DiscountType
  discount_value Decimal      @db.Decimal(15, 2)
  max_uses       Int?
  used_count     Int          @default(0)
  expires_at     DateTime?
  is_active      Boolean      @default(true)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  shop  Shop   @relation(fields: [shop_id], references: [id])
  sales Sale[]

  @@index([shop_id])
  @@map("promotions")
}

model ProductType {
  id         String   @id @default(uuid())
  shop_id    String
  name_i18n  Json
  code       String
  icon       String?
  // Stale comment fixed: actual values are PRODUCTS_TYPES in
  // src/constants/input-types.ts — "product" | "semi_finished" |
  // "container" | "finished_good" | "ingredient" (this comment used to
  // say "raw_material" and omitted "container"/"ingredient" entirely).
  // Left as a plain string rather than converting to an enum in this
  // pass — it's compared across many more route files than status/
  // payment_status/discount_type were, and deserves its own dedicated
  // verification pass rather than bundling it in here.
  type       String   @default("product")
  sort_order Int      @default(0)
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  shop     Shop      @relation(fields: [shop_id], references: [id])
  products Product[]

  @@unique([shop_id, code])
  @@map("product_types")
}

// RawMaterial model removed - merged into Product model
// Use product_type_id to distinguish between raw materials and finished products

model StockMovement {
  id           String @id @default(uuid())
  product_id   String
  warehouse_id String

  // Movement type: "manual_adjustment", "sale", "purchase", "production", "transfer", "return", "damage", "expired", "count"
  movement_type String

  // Transaction direction: "in" (increase), "out" (decrease)
  direction String

  // Quantities
  quantity_before Decimal @db.Decimal(15, 4)
  quantity_change Decimal @db.Decimal(15, 4) // Always positive, direction determines +/-
  quantity_after  Decimal @db.Decimal(15, 4)

  // Reference to source document (optional)
  reference_type String? // "sale", "purchase_order", "production", "transfer", etc.
  reference_id   String? // ID of the source document

  // Reason and notes
  reason_code String? // Standardized reason code for reporting
  reason_text String // Human-readable reason
  note        String? @db.Text

  // Audit trail
  created_by       String
  created_at       DateTime @default(now())
  transaction_date DateTime @default(now())

  @@index([product_id])
  @@index([warehouse_id])
  @@index([movement_type])
  @@index([transaction_date])
  @@index([reference_type, reference_id])
  @@map("stock_movements")
}

// Media Management System
model Media {
  id String @id @default(uuid())

  // File information
  filename        String // Original filename
  stored_filename String @unique // UUID-based filename in storage
  file_path       String // Relative path: /uploads/2026/03/xxx.jpg
  file_size       Int // Size in bytes
  mime_type       String // image/jpeg, image/png, etc.

  // Image metadata
  width    Int?
  height   Int?
  alt_text String? @db.Text

  // Thumbnails
  thumbnail_path String? // Path to thumbnail
  medium_path    String? // Path to medium size

  // Usage tracking
  entity_type String? // "product", "category", "user", etc.
  entity_id   String? // ID of the related entity

  // Organization
  folder String @default("general") // Category folder

  // Audit
  uploaded_by String?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  // Relations
  product_images ProductMedia[]

  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("media")
}

model ProductMedia {
  id         String   @id @default(uuid())
  product_id String
  media_id   String
  is_primary Boolean  @default(false) // รูปหลัก
  sort_order Int      @default(0)
  created_at DateTime @default(now())

  product Product @relation(fields: [product_id], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [media_id], references: [id], onDelete: Cascade)

  @@unique([product_id, media_id])
  @@index([product_id, is_primary])
  @@map("product_media")
}

// One row per shop, keyed by shop_id — holding that shop's theme
// preferences. Starts with just the selectable theme color; a real
// key-value settings table would be premature until a second setting exists.
model AppSettings {
  shop_id           String   @id
  theme_color       String   @default("#213559")
  theme_color_light String   @default("#2c4a7a")
  theme_color_dark  String   @default("#1a2844")
  updated_at        DateTime @updatedAt

  shop Shop @relation(fields: [shop_id], references: [id], onDelete: Cascade)

  @@map("app_settings")
}
