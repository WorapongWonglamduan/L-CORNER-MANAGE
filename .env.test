# Separate database from .env's dev DB — tests create/mutate/delete real
# rows (sales, stock movements, ...), and running them against the actual
# dev database would corrupt whatever you're looking at in the app.
DB_HOST=localhost
DB_PORT=5435
DB_DATABASE=l_corner_pos_test
DB_USERNAME=postgres
DB_PASSWORD=postgres

NEXTAUTH_SECRET=test-secret-not-for-real-use
NEXTAUTH_URL=http://localhost:3077
NODE_ENV=test
