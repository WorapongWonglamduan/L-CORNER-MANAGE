# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=l_corner_pos

# Database URL for Prisma
DATABASE_URL=postgresql://postgres:postgres@localhost:5435/l_corner_pos?schema=public

# Next.js Configuration
NODE_ENV=development
PORT=3077
NEXT_PUBLIC_APP_URL=http://localhost:3077

# NextAuth Configuration
NEXTAUTH_URL=http://localhost:3077
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# PgAdmin Configuration
PGADMIN_EMAIL=admin@lcorner.local
PGADMIN_PASSWORD=admin

# Application Settings
DEFAULT_LANGUAGE=th
SUPPORTED_LANGUAGES=th,en

# Business Settings
BUSINESS_NAME=L-Corner
BUSINESS_TAX_ID=
BUSINESS_ADDRESS=
BUSINESS_PHONE=
BUSINESS_EMAIL=

# Payment Settings
ENABLE_CASH=true
ENABLE_CREDIT_CARD=true
ENABLE_QR_PAYMENT=true
ENABLE_BANK_TRANSFER=true

# Inventory Settings
LOW_STOCK_ALERT=true
AUTO_REORDER=false

# Receipt Settings
RECEIPT_PRINTER_ENABLED=false
RECEIPT_WIDTH=80
RECEIPT_COPIES=1

# Session Settings
SESSION_TIMEOUT=3600
MAX_LOGIN_ATTEMPTS=5

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,webp

# Logging
LOG_LEVEL=info
LOG_FILE_ENABLED=false
