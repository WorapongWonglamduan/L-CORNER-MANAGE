# Database Configuration
DB_HOST=localhost
DB_PORT=5435
DB_DATABASE=l_corner_pos
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Next.js Configuration
NODE_ENV=development
PORT=3077
NEXT_PUBLIC_APP_URL=http://localhost:3077

# --- Production (docker-compose.yml) ---
# The domain itself is set in deploy/reverse-proxy/Caddyfile (shared across
# every project on the VPS), not here. NEXTAUTH_URL just needs to match it —
# the public https:// URL in production, never localhost. HTTPS is required,
# not optional: the BLE receipt-printer feature (Web Bluetooth) refuses to
# run without a secure context.
NEXTAUTH_URL=https://pos.yourdomain.com

# NextAuth Configuration
# Generate a real value before deploying — never reuse this placeholder:
#   openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# PgAdmin Configuration
PGADMIN_EMAIL=admin@lcorner.local
PGADMIN_PASSWORD=admin

# Login lockout (src/lib/login-lockout.ts)
MAX_LOGIN_ATTEMPTS=5

# Image storage (src/lib/storage) — "local" (default) writes under
# public/uploads, persisted via the uploads_data Docker volume below.
# Set to "r2" to store on Cloudflare R2 instead (create a bucket + a
# scoped API token on the R2 dashboard first, and a public custom domain —
# the free *.r2.dev domain is rate-limited and not for production use).
STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=https://images.yourdomain.com

# Payment gateways (src/lib/payments) — POS checkout's "PromptPay (Omise)"
# button only appears once NEXT_PUBLIC_OMISE_PUBLIC_KEY is set (it's safe to
# expose client-side — it's what Omise.js uses for card tokenization).
# Free sandbox signup at omise.co (Opn Payments) → Dashboard → Test mode →
# API keys. OMISE_WEBHOOK_SECRET is only needed to verify webhook
# signatures — createCharge/getChargeStatus (and the whole PromptPay QR +
# polling flow) work without it, since GET /api/payments/intents/[id]
# always re-checks the gateway directly regardless of whether any webhook
# ever arrives. See src/lib/payments/README.md for the other drivers
# (2C2P/PayPal/TrueMoney/Rabbit LINE Pay), which are unconfigured skeletons.
# OMISE_SECRET_KEY=
# OMISE_PUBLIC_KEY=
# NEXT_PUBLIC_OMISE_PUBLIC_KEY=
# OMISE_WEBHOOK_SECRET=
