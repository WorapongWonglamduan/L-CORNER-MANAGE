# Database Configuration
DB_HOST=localhost
DB_PORT=5435
DB_DATABASE=l_corner_pos
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Next.js Configuration
NODE_ENV=development
PORT=3077
# Used by src/lib/payments/paypal-driver.ts to build PayPal's return/cancel
# redirect URLs. This value only matters for local `npm run dev` — in a
# Docker deploy it must instead be set as the NEXT_PUBLIC_APP_URL build arg
# (docker-compose.yml's app.build.args locally, or the
# NEXT_PUBLIC_APP_URL_PROD/NEXT_PUBLIC_APP_URL_UAT GitHub repo Variables for
# the real CI-built image) — Next.js inlines NEXT_PUBLIC_* vars at build
# time, so this .env value alone never reaches a built image.
NEXT_PUBLIC_APP_URL=http://localhost:3077

# --- Production (docker-compose.yml) ---
# The domain itself is set in deploy/reverse-proxy/Caddyfile (shared across
# every project on the VPS), not here. NEXTAUTH_URL just needs to match it —
# the public https:// URL in production, never localhost. HTTPS is required,
# not optional: the BLE receipt-printer feature (Web Bluetooth) refuses to
# run without a secure context.
NEXTAUTH_URL=https://pos.yourdomain.com

# --- UAT (only needed for a second copy of this stack on the same VPS) ---
# Leave both commented out for prod — the defaults reproduce prod's exact
# original names/port. For a UAT deploy, set ENV_SUFFIX so its container
# names/DB volume don't collide with prod's, and POSTGRES_HOST_PORT so its
# Postgres doesn't try to bind the same host port prod already uses.
# ENV_SUFFIX=-uat
# POSTGRES_HOST_PORT=5436
# IMAGE_TAG=staging
# Set to show the login page's test-account box on UAT only (see
# src/components/pages/login/login-form.tsx) — leave commented for prod.
# Also flips useSecureCookies/secureCookie (auth.ts, proxy.ts) and any
# Next.js internal behavior gated on NODE_ENV === 'production', accepted as
# a deliberate tradeoff for this stack.
# NODE_ENV=development

# NextAuth Configuration
# Generate a real value before deploying — never reuse this placeholder:
#   openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-key-here-change-in-production

# PgAdmin Configuration
PGADMIN_EMAIL=admin@lcorner.local
PGADMIN_PASSWORD=admin

# Login lockout (src/lib/login-lockout.ts)
MAX_LOGIN_ATTEMPTS=5

# Image storage (src/lib/storage) — "local" (default) writes under
# public/uploads, persisted via the uploads_data Docker volume below.
# Set to "r2" to store on Cloudflare R2 instead (create a bucket + a
# scoped API token on the R2 dashboard first, and a public custom domain —
# the free *.r2.dev domain is rate-limited and not for production use).
STORAGE_DRIVER=local
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=https://images.yourdomain.com

# Payment gateways (src/lib/payments) — POS checkout's "PromptPay (Omise)"
# and "TrueMoney QR (Omise)" buttons only appear once
# NEXT_PUBLIC_OMISE_PUBLIC_KEY is set (it's safe to expose client-side —
# it's what Omise.js uses for card tokenization; TrueMoney QR reuses the
# same OmiseDriver, no separate credentials needed). Free sandbox signup at
# omise.co (Opn Payments) → Dashboard → Test mode → API keys.
# OMISE_WEBHOOK_SECRET is only needed to verify webhook signatures —
# createCharge/getChargeStatus (and the whole QR + polling flow) work
# without it, since GET /api/payments/intents/[id] always re-checks the
# gateway directly regardless of whether any webhook ever arrives. See
# src/lib/payments/README.md for the remaining unconfigured skeletons
# (2C2P/TrueMoney-direct/Rabbit LINE Pay).
# OMISE_SECRET_KEY=
# OMISE_PUBLIC_KEY=
# NEXT_PUBLIC_OMISE_PUBLIC_KEY=
# OMISE_WEBHOOK_SECRET=

# PayPal (src/lib/payments/paypal-driver.ts) — Orders API v2, sandbox app at
# developer.paypal.com → Dashboard → Apps & Credentials → Sandbox. No public
# key needed client-side (this is a pure server-to-server integration, no
# PayPal JS SDK) — NEXT_PUBLIC_PAYPAL_ENABLED is just a UI feature flag to
# show the button once the two secrets below are actually set.
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# NEXT_PUBLIC_PAYPAL_ENABLED=true
# PAYPAL_API_BASE=https://api-m.sandbox.paypal.com
# Note: PayPal's sandbox has been observed rejecting THB charges
# ("in accordance with international regulations, this transaction has
# been rejected") for a Thailand-country sandbox Business account
# regardless of the buyer account's country/currency — this looks like
# a real restriction on receiving cross-border payments into a Thai
# account (PayPal Thailand has known limits here), not a bug in this
# app. If you hit this, it's a PayPal/account-configuration issue to
# resolve on their dashboard, not something to work around by changing
# currency here — there is no currency-conversion step in this app, so
# charging anything other than THB would charge the wrong amount.
